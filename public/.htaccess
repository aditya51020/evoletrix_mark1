DirectoryIndex index.html
Options -Indexes

# --- Security headers -------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
</IfModule>

# --- Caching ------------------------------------------------------------
# Without an explicit Cache-Control, browsers fall back to heuristic
# caching off Last-Modified — which can hold onto a stale index.html
# after a deploy until something forces revalidation (e.g. a hard
# refresh). index.html (and the SPA shell it falls back to) must always
# be revalidated so a new deploy is visible on the very next load, not
# just after a manual refresh.
#
# The hashed files under /assets/ are safe to cache aggressively and
# forever: Vite gives each one a content hash in its filename, so a
# changed file is always a new URL, never a stale cache hit.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|png|jpe?g|gif|svg|webp|ico|woff2?)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpe?g|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Block direct access to include-only PHP files (bootstrap.inc.php etc.)
<FilesMatch "\.inc\.php$">
  Require all denied
</FilesMatch>

RewriteEngine On

# --- Canonical host + HTTPS ------------------------------------------
# Apache/.htaccess only — `php -S` (local dev) never reads this file,
# so it has zero effect there; it only ever runs on real Hostinger hosting.

# www.evoletrix.com (any scheme) -> https://evoletrix.com, same path+query
RewriteCond %{HTTP_HOST} ^www\.evoletrix\.com$ [NC]
RewriteRule ^ https://evoletrix.com%{REQUEST_URI} [L,R=301,QSA]

# Any remaining plain-HTTP request -> HTTPS, same host/path/query
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,QSA]

# Block direct access to the PHPMailer vendor lib
RewriteRule ^api/lib/ - [F,L]

# Serve real files and directories as-is (this lets /api/*.php through
# untouched, since those are real files on disk)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Any /api/ path that didn't match a real file above is a dead endpoint —
# return a real 404, never the SPA shell. Without this, a typo'd or
# retired API URL would get a 200 + the HTML app body, which silently
# breaks any fetch() expecting JSON instead of failing loudly.
RewriteRule ^api/ - [R=404,L]

# Everything else falls back to the SPA shell
RewriteRule ^ index.html [L]
